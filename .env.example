# Server
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Optional OpenAI-compatible LLM Assistant
# Leave LLM_API_KEY empty to run purely deterministically (zero LLM costs)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Security & Caching
LLM_ALLOW_BYOK=true
LLM_RATE_LIMIT_PER_MIN=20
LLM_TIMEOUT_MS=20000
LLM_CACHE_MAX=500
LLM_CACHE_TTL_MS=3600000
