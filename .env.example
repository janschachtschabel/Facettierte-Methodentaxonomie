# Server
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Optional OpenAI-compatible Server LLM (strictly opt-in via LLM_API_KEY)
# Leave LLM_API_KEY empty for Zero-LLM mode (default): API & MCP answer in <5 ms and return
# structured prompt briefings for the caller's own LLM; Web users can configure their own
# OpenAI-compatible LLM (OpenAI, Gemini, Mistral, OpenRouter, Ollama, LM Studio, LiteLLM...) in UI Settings.
# Set LLM_USE_OPENAI_ENV=true only if you explicitly want to reuse an OS-level OPENAI_API_KEY.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_USE_OPENAI_ENV=false
LLM_REASONING_EFFORT=low

# Optional local Model2Vec static German edu embeddings (npm run download:m2v)
# FMT_M2V_MODEL_DIR=./models/m2v-qwen3-4b-256-edu

# Security & Caching
LLM_ALLOW_BYOK=true
LLM_RATE_LIMIT_PER_MIN=20
LLM_TIMEOUT_MS=45000
LLM_CACHE_MAX=500
LLM_CACHE_TTL_MS=3600000
