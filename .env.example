# Hostinger Docker Manager: diese Datei wird beim ersten Deploy automatisch als .env übernommen.
# Alle Werte sind optional — der erste Deploy gelingt komplett ohne Änderungen.

# Reiner Hostname für Traefik & Let's Encrypt (OHNE https:// und OHNE abschließenden Slash!)
# Beispiel: methoden.deine-domain.de oder srvNNNNNN.hstgr.cloud
DOMAIN=

# Optionaler direkter Host-Port (Standard: 8120 → http://<VPS-IP>:8120)
# Für reinen Traefik-HTTPS-Betrieb nach dem Domain-Setup einfach HOST_BIND=127.0.0.1 setzen.
HOST_PORT=8120
HOST_BIND=0.0.0.0

# Traefik-Einstellungen auf dem VPS (Hostinger-Standardwerte werden bei leerem Wert genutzt)
# TRAEFIK_NETWORK=fmt-methodendatenbank-web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Image-Überschreibung (optional; Standard: öffentliches Multi-Arch-Image auf GHCR)
# FMT_IMAGE=ghcr.io/janschachtschabel/facettierte-methodentaxonomie:latest
# FMT_IMAGE=<dein-dockerhub-user>/fmt-methodendatenbank:latest

# CORS-Ursprünge (* erlaubt Zugriff durch externe MCP-/Web-Clients)
CORS_ORIGIN=*

# Reverse-Proxy-Hops (1 hinter Hostingers Traefik; 0 für rein lokalen Betrieb ohne Proxy)
# TRUST_PROXY=1

# Optional: Lokales statisches Model2Vec-Embedding (npm run download:m2v; "none" deaktiviert es explizit)
# FMT_M2V_MODEL_DIR=/app/models/m2v-qwen3-4b-256-edu

# Optionales Server-LLM (strikt opt-in über LLM_API_KEY)
# Leer lassen für den schnellen Zero-LLM-Modus (<5 ms).
# Endnutzer können jederzeit in der App unter „⚙ KI-Einstellungen“ ihre eigene
# OpenAI-kompatible KI (OpenAI, Mistral, Gemini, GWDG, OpenRouter, Ollama, LM Studio …) eintragen.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_USE_OPENAI_ENV=false
LLM_REASONING_EFFORT=low

# Sicherheit & Caching
LLM_ALLOW_BYOK=true
LLM_RATE_LIMIT_PER_MIN=20
# Anfragen pro Minute und IP auf die Rechen-Endpunkte ohne LLM (match, plan, adapt …)
API_RATE_LIMIT_PER_MIN=300
LLM_TIMEOUT_MS=90000
LLM_CACHE_MAX=500
LLM_CACHE_TTL_MS=3600000

# Kontaktformular im Impressum (optional). Ohne SMTP_HOST zeigt das Formular „nicht eingerichtet“;
# die E-Mail-Adresse im Impressum bleibt trotzdem abrufbar.
# Nachrichten gehen standardmäßig an die Adresse aus dem Impressum; CONTACT_TO leitet sie an eine andere Adresse um
# (die im Impressum angezeigte Adresse bleibt dabei gleich).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE: true bei Port 465 (TLS von Anfang an), sonst STARTTLS (Pflicht, außer bei einem Relay auf localhost)
# SMTP_SECURE=false
# SMTP_USER=kontakt@example.org
# SMTP_PASS=
# CONTACT_FROM: Absender, muss zum SMTP-Konto passen (Standard: SMTP_USER)
# CONTACT_FROM=kontakt@example.org
# CONTACT_TO=
# CONTACT_RATE_LIMIT_PER_HOUR: Nachrichten pro IP und Stunde
# CONTACT_RATE_LIMIT_PER_HOUR=10
