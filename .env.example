# Server
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Optional OpenAI-compatible LLM Assistant
# Default provider is OpenAI with gpt-6-luna (GPT-5 & GPT-6 series parameters supported).
# Uses LLM_API_KEY, or automatically falls back to OS OPENAI_API_KEY when LLM_BASE_URL points to api.openai.com.
# Set LLM_API_KEY=none to force purely deterministic zero-LLM mode even if OPENAI_API_KEY exists in OS env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_REASONING_EFFORT=low

# Security & Caching
LLM_ALLOW_BYOK=true
LLM_RATE_LIMIT_PER_MIN=20
LLM_TIMEOUT_MS=45000
LLM_CACHE_MAX=500
LLM_CACHE_TTL_MS=3600000
